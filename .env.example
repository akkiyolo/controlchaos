# =====================================================================
# ControlChaos environment file
# Copy to .env and fill in. NEVER commit .env. All data is synthetic.
# =====================================================================

# ---------- App ----------
APP_ENV=development
APP_NAME=ControlChaos
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:8000,http://localhost:5500

# ---------- Database (Render EXTERNAL URL) ----------
# Render shows:  postgres://USER:PASSWORD@HOST.<region>-postgres.render.com/DBNAME
# Rewrite it to: postgresql+psycopg://USER:PASSWORD@HOST.<region>-postgres.render.com/DBNAME?sslmode=require
# Use the External URL (the Internal URL only works inside Render).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST.oregon-postgres.render.com/DBNAME?sslmode=require
# Separate database/schema for tests. Never point this at the same DB as above.
TEST_DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_PRE_PING=true

# ---------- Auth ----------
# Generate: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# ---------- Audit log ----------
# Generate: openssl rand -hex 16
AUDIT_HASH_SALT=

# ---------- LLM providers (Groq + Gemini via OpenAI-compatible APIs) ----------
# Global fallback provider: mock | groq | gemini
LLM_PROVIDER=mock

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
LLM_RPM_LIMIT_GROQ=25

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash
LLM_RPM_LIMIT_GEMINI=10

# Per-agent routing (blank = use LLM_PROVIDER). Keep Architect and Skeptic on
# DIFFERENT providers so the reviewer does not share the proposer's blind spots.
AGENT_PROVIDER_ADVERSARY=groq
AGENT_PROVIDER_INVESTIGATOR=groq
AGENT_PROVIDER_ARCHITECT=gemini
AGENT_PROVIDER_SKEPTIC=groq
AGENT_PROVIDER_VARIANCE=gemini

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=4

# ---------- Agent budgets ----------
AGENT_MAX_STEPS=25
AGENT_MAX_TOKENS_PER_WORKFLOW=200000

# ---------- Demo / seeding ----------
SEED_DEMO_USERS=true
DEMO_ADMIN_EMAIL=admin@controlchaos.local
DEMO_ADMIN_PASSWORD=
DEFAULT_RANDOM_SEED=42